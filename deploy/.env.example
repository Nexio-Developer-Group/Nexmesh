# Copy to deploy/.env and edit.

# Required. 32 random bytes, base64. Generate with: deploy/gen-key.sh
NEXMESH_MASTER_KEY=

# Database password (change it for anything beyond local use).
POSTGRES_PASSWORD=nexmesh

# Port published on the host.
NEXMESH_PORT=8080

# Per-workspace limits enforced when creating or editing a workspace.
NEXMESH_MAX_CPU=8
NEXMESH_MAX_RAM_GB=16
NEXMESH_MAX_STORAGE_GB=100

# "ubuntu:24.04" runs an idle container. Build the workspace image (see
# docker-compose.yml) and set nexmesh/workspace:local to run the agent in it.
NEXMESH_WORKSPACE_IMAGE=ubuntu:24.04

# Allow Test Connection to reach services on private (RFC 1918) networks.
NEXMESH_ALLOW_PRIVATE_EGRESS=false
