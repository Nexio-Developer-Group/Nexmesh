{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexmesh.dev/schema/template.schema.json",
  "title": "Nexmesh stack template",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "components"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "order": { "type": "integer" },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "suggestedMode": { "enum": ["install", "connect"] },
          "version": { "type": "string" }
        }
      }
    }
  }
}
