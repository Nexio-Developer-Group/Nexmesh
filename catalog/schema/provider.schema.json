{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexmesh.dev/schema/provider.schema.json",
  "title": "Nexmesh code agent provider",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "tagline", "order", "hosted", "protocols", "fields"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "order": { "type": "integer", "minimum": 1 },
    "hosted": { "type": "boolean", "description": "Hosted providers need an API key and send prompts to a third party." },
    "protocols": { "type": "array", "minItems": 1, "items": { "enum": ["anthropic", "openai", "gemini", "ollama"] } },
    "baseUrl": { "type": "string" },
    "defaultModel": { "type": "string" },
    "notice": { "type": "string", "description": "Shown under the form, for example where prompts are sent." },
    "comingSoon": { "type": "array", "items": { "type": "string" } },
    "fields": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "label", "type"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string" }, "label": { "type": "string" },
          "type": { "enum": ["string", "password", "select", "boolean", "number"] },
          "required": { "type": "boolean" }, "advanced": { "type": "boolean" },
          "placeholder": { "type": "string" }, "help": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
